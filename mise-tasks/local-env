#!/usr/bin/env python3
#MISE description="Manage infrastructure and all module Compose files"

import argparse
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys


def collect_gateway_config(root, modules):
    # Flatten YAML files without parsing/merging them: gateway owns the merge
    # semantics. Separate namespaces prevent modules with routes.yaml colliding.
    sources = [("root", root / "config/gateway")]
    sources.extend((path.parent.name, path.parent / "config/gateway") for path in modules)
    files = []
    for namespace, directory in sources:
        for path in sorted(directory.rglob("*")):
            if path.is_file() and path.suffix in {".yaml", ".yml"}:
                files.append((f"{len(files):04d}-{namespace}-{path.name}", path.read_bytes()))
    if not files or not files[0][0].startswith("0000-root-"):
        sys.exit("Missing gateway configuration in config/gateway")
    target = root / "dist/local/gateway"
    # Keep the mount directory itself in place for already-running containers.
    target.mkdir(parents=True, exist_ok=True)
    names = {name for name, _ in files}
    for path in target.iterdir():
        if path.name in names:
            continue
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
    digest = hashlib.sha256()
    for name, content in files:
        destination = target / name
        if not destination.exists() or destination.read_bytes() != content:
            temporary = destination.with_suffix(".tmp")
            temporary.write_bytes(content)
            temporary.replace(destination)
        digest.update(name.encode() + b"\0" + content + b"\0")
    return digest.hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["up", "down", "ps", "config", "logs"])
    parser.add_argument("--infra-only", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    modules = sorted(root.glob("modules/*/compose.yaml"), key=lambda path: (path.parent.name != "template", path.parent.name))
    env = dict(os.environ)
    if args.action in {"up", "config"}:
        env["LOCAL_GATEWAY_CONFIG_HASH"] = collect_gateway_config(root, modules)
    used_ports = set()
    keys = [f"{path.parent.name.upper()}_{kind}_PORT" for path in modules for kind in ["GRPC", "HTTP", "MESSAGE_HANDLER"]]
    for key in keys:
        if key in env:
            port = int(env[key])
            if not 0 < port < 65536 or port in used_ports:
                sys.exit(f"Invalid or duplicate local port: {key}={port}")
            used_ports.add(port)
    next_port = 8081
    for key in keys:
        if key not in env:
            while next_port in used_ports:
                next_port += 1
            if next_port >= 65536:
                sys.exit("No local ports available")
            env[key] = str(next_port)
            used_ports.add(next_port)
            next_port += 1
    command = ["docker", "compose", "--project-name", env.get("LOCAL_ENV_PROJECT", "distributed-programming-local"), "--project-directory", str(root), "-f", str(root / "compose.yaml")]
    for path in modules:
        command.extend(["-f", str(path)])

    def compose(*arguments, **kwargs):
        subprocess.run(command + list(arguments), cwd=root, env=env, check=True, **kwargs)

    if args.action == "up":
        if not args.infra_only:
            # Validate with the exact image used at runtime, before starting
            # infrastructure. No dependency on a sibling gateway checkout.
            compose("run", "--rm", "--no-deps", "gateway", "--config", "/config", "check-config")
            architecture = subprocess.check_output(["docker", "info", "--format", "{{.Architecture}}"], env=env, text=True).strip()
            env["GOARCH"] = {"aarch64": "arm64", "x86_64": "amd64"}.get(architecture, architecture)
            for path in modules:
                subprocess.run(["mise", "run", f"//modules/{path.parent.name}:build"], cwd=root, env=env, check=True)
        compose("up", "-d", "--wait", "mysql", "rabbitmq")
        # Provision every module on each up, including modules added after
        # the infrastructure volumes were created.
        for path in modules:
            init_sql = path.parent / "docker/mysql/init.sql"
            if init_sql.exists():
                compose("exec", "-T", "mysql", "sh", "-c", 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql --user=root', input=init_sql.read_text(), text=True)
        if not args.infra_only:
            compose("up", "-d", "--build", "--wait")
            print(f"gateway: HTTP={env.get('LOCAL_GATEWAY_PORT', '80')}, health={env.get('LOCAL_GATEWAY_HEALTH_PORT', '15000')}")
            for path in modules:
                prefix = path.parent.name.upper()
                print(f"{path.parent.name}: gRPC={env[prefix + '_GRPC_PORT']}, HTTP={env[prefix + '_HTTP_PORT']}, consumer health={env[prefix + '_MESSAGE_HANDLER_PORT']}")
    elif args.action == "down":
        compose("down", "--remove-orphans")
    elif args.action == "logs":
        compose("logs", "--tail", "100", "-f")
    else:
        compose(args.action)


if __name__ == "__main__":
    main()
